{
  "$schema": "http://json.schemastore.org/template",
  "author": "rex",
  "classifications": [
    "Web",
    "SPA",
    "ASP.NET Core",
    "Angular",
    "SvelteKit",
    "Nuxt"
  ],
  "identity": "AspNetCoreSpaSkeleton",
  "name": "ASP.NET Core + SPA Skeleton",
  "description": "ASP.NET Core Web API + SPA(Angular · SvelteKit · Nuxt) 스켈레톤. 공유 라이브러리(Common)와 앱(Server · InternalApi · Batch)으로 나눈 레이어드 구조, 클라우드별 비밀값 출처 프로파일(Local · Aws · Azure · Gcp), 테스트 4분류(단위 · 기능 · 통합 · 브라우저)가 배선돼 있다.",
  "shortName": "aspnet-spa-skeleton",
  "sourceName": "AspNetCoreSkeletonApplication",
  "preferNameDirectory": true,
  "guids": [
    "352c4267-d2dd-461e-8203-8604ccb52ac8"
  ],
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "forms": {
    "kebab": {
      "identifier": "kebabCase"
    }
  },
  "symbols": {
    "frontend": {
      "type": "parameter",
      "datatype": "choice",
      "description": "포함할 SPA 클라이언트",
      "defaultValue": "angular",
      "choices": [
        {
          "choice": "angular",
          "description": "Angular"
        },
        {
          "choice": "sveltekit",
          "description": "SvelteKit (SPA 정적 빌드)"
        },
        {
          "choice": "nuxt",
          "description": "Nuxt (SPA 정적 빌드)"
        },
        {
          "choice": "all",
          "description": "셋 다 — SpaClient 속성으로 전환"
        }
      ]
    },
    "internalApi": {
      "type": "parameter",
      "datatype": "bool",
      "description": "게이트웨이 뒤 내부 API 앱(InternalApi)을 함께 만든다 — Server 와 Common 을 같이 쓴다",
      "defaultValue": "true"
    },
    "batch": {
      "type": "parameter",
      "datatype": "bool",
      "description": "배치 앱(Batch — Quartz.NET 스케줄 · 웹훅 · 대시보드)을 함께 만든다 — Common 을 같이 쓴다",
      "defaultValue": "true"
    },
    "publicOrigin": {
      "type": "generated",
      "generator": "switch",
      "description": "Local 프로파일의 App:PublicOrigin — 고른 SPA 의 dev 서버 출처(메일 링크가 가리킨다)",
      "replaces": "https://localhost:61194",
      "onlyIf": [
        {
          "after": "\"PublicOrigin\": \""
        }
      ],
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(frontend == \"sveltekit\")",
            "value": "https://localhost:61195"
          },
          {
            "condition": "(frontend == \"nuxt\")",
            "value": "https://localhost:61196"
          },
          {
            "condition": "(true)",
            "value": "https://localhost:61194"
          }
        ]
      }
    },
    "pruneTokensInServer": {
      "type": "generated",
      "generator": "switch",
      "description": "Server 의 Authentication:OAuthServer:TokenPruning:RunInServer — Batch 를 빼면 만료 OAuth 토큰을 Server 가 정리한다",
      "replaces": "false",
      "onlyIf": [
        {
          "after": "\"RunInServer\": "
        }
      ],
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(!batch)",
            "value": "true"
          },
          {
            "condition": "(true)",
            "value": "false"
          }
        ]
      }
    },
    "kebabName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "kebab",
      "replaces": "asp-net-core-skeleton-application",
      "fileRename": "asp-net-core-skeleton-application"
    }
  },
  "sources": [
    {
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/obj\\*/**",
        "**/*.user",
        "**/*.lock.json",
        "**/*.filelist",
        ".template.config/**",
        ".git/**",
        ".vs/**",
        ".idea/**",
        ".claude/**",
        "**/.DS_Store",
        "**/TestResults/**",
        "**/node_modules/**",
        "**/.angular/**",
        "**/dist/**",
        "**/.svelte-kit/**",
        "src/spa/*/build/**",
        "**/.nuxt/**",
        "**/.output/**",
        "**/.data/**"
      ],
      "copyOnly": [
        "**/*.ico",
        "**/*.png",
        "**/*.svg"
      ],
      "modifiers": [
        {
          "condition": "(!batch)",
          "exclude": [
            "src/batch/**",
            "test/*/*/Batch/**"
          ]
        },
        {
          "condition": "(!internalApi)",
          "exclude": [
            "src/internal-api/**",
            "test/*/*/InternalApi/**"
          ]
        },
        {
          "condition": "(frontend != \"angular\" && frontend != \"all\")",
          "exclude": [
            "src/spa/asp-net-core-skeleton-application.client.angular/**"
          ]
        },
        {
          "condition": "(frontend != \"sveltekit\" && frontend != \"all\")",
          "exclude": [
            "src/spa/asp-net-core-skeleton-application.client.sveltekit/**"
          ]
        },
        {
          "condition": "(frontend != \"nuxt\" && frontend != \"all\")",
          "exclude": [
            "src/spa/asp-net-core-skeleton-application.client.nuxt/**"
          ]
        }
      ]
    }
  ],
  "SpecialCustomOperations": {
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "actionableIf": [
              "<!--#if"
            ],
            "actionableElse": [
              "<!--#else"
            ],
            "actionableElseif": [
              "<!--#elif"
            ],
            "endif": [
              "<!--#endif"
            ],
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    }
  }
}
