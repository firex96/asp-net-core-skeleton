{
  // Gcp 프로파일 — GCP Secret Manager 에서 Secrets 에 적은 비밀만 읽는다. 비밀 이름의 -- 는 : 로 바뀐다.
  //   ProjectId : 비밀이 있는 프로젝트. 환경변수 Gcp__SecretManager__ProjectId 로도 줄 수 있다
  //   자격증명 : Application Default Credentials (워크로드 ID, GOOGLE_APPLICATION_CREDENTIALS 등)
  // 비밀을 추가하면 Secrets 에도 추가한다. 소셜 로그인 공급자를 켜면 그 공급자의 비밀도 추가한다
  // (예: "Authentication--External--Google--ClientSecret") — 목록의 비밀이 없으면 기동하다 멈추므로 켠 공급자만 적는다.
  // OAuth 기밀 클라이언트의 비밀도 같다(예: "Authentication--OAuthServer--Clients--0--ClientSecret").
  "Gcp": {
    "SecretManager": {
      "ProjectId": "",
      "Secrets": [
        "ConnectionStrings--Default",
        "ConnectionStrings--Redis",
        "Mail--Smtp--Password",
        "Authentication--OAuthServer--SigningCertificate",
        "Authentication--OAuthServer--EncryptionCertificate"
      ]
    }
  }
}
