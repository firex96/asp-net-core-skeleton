<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AspNetCoreSkeletonApplication.Server</RootNamespace>
    <UserSecretsId>352c4267-d2dd-461e-8203-8604ccb52ac8</UserSecretsId>
  </PropertyGroup>
  <!--#if (frontend == "all") -->
  <!--
    SPA 클라이언트 선택: angular (기본) | sveltekit | nuxt
    예) dotnet run -p:SpaClient=sveltekit   또는   환경 변수 SpaClient=nuxt
    (스켈레톤 원본의 #if 주석은 dotnet new 템플릿용이다 — 원본에서는 그냥 주석이라 첫 줄 angular 가 기본값이 된다.)
  -->
  <!--#endif -->
  <PropertyGroup>
    <!--#if (frontend == "angular" || frontend == "all") -->
    <SpaClient Condition="'$(SpaClient)' == ''">angular</SpaClient>
    <!--#elif (frontend == "sveltekit") -->
    <SpaClient Condition="'$(SpaClient)' == ''">sveltekit</SpaClient>
    <!--#elif (frontend == "nuxt") -->
    <SpaClient Condition="'$(SpaClient)' == ''">nuxt</SpaClient>
    <!--#endif -->
    <SpaProxyLaunchCommand>npm start</SpaProxyLaunchCommand>
  </PropertyGroup>
  <Choose>
    <!--#if (frontend == "angular" || frontend == "all") -->
    <When Condition="'$(SpaClient)' == 'angular'">
      <PropertyGroup>
        <SpaClientName>asp-net-core-skeleton-application.client.angular</SpaClientName>
        <SpaProxyServerUrl>https://localhost:61194</SpaProxyServerUrl>
      </PropertyGroup>
    </When>
    <!--#endif -->
    <!--#if (frontend == "sveltekit" || frontend == "all") -->
    <When Condition="'$(SpaClient)' == 'sveltekit'">
      <PropertyGroup>
        <SpaClientName>asp-net-core-skeleton-application.client.sveltekit</SpaClientName>
        <SpaProxyServerUrl>https://localhost:61195</SpaProxyServerUrl>
      </PropertyGroup>
    </When>
    <!--#endif -->
    <!--#if (frontend == "nuxt" || frontend == "all") -->
    <When Condition="'$(SpaClient)' == 'nuxt'">
      <PropertyGroup>
        <SpaClientName>asp-net-core-skeleton-application.client.nuxt</SpaClientName>
        <SpaProxyServerUrl>https://localhost:61196</SpaProxyServerUrl>
      </PropertyGroup>
    </When>
    <!--#endif -->
  </Choose>
  <PropertyGroup>
    <SpaRoot>..\..\spa\$(SpaClientName)</SpaRoot>
  </PropertyGroup>
  <Target Name="ValidateSpaClient" BeforeTargets="Build" Condition="'$(SpaClientName)' == ''">
    <Error Text="알 수 없는 SpaClient '$(SpaClient)'. angular, sveltekit, nuxt 중 하나를 지정하세요." />
  </Target>
  <ItemGroup>
    <PackageReference Include="Amazon.Extensions.Configuration.SystemsManager" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Google.Cloud.SecretManager.V1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Riok.Mapperly" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\application-core\AspNetCoreSkeletonApplication.ApplicationCore\AspNetCoreSkeletonApplication.ApplicationCore.csproj" />
    <ProjectReference Include="..\..\infrastructure\AspNetCoreSkeletonApplication.Infrastructure.EntityFramework\AspNetCoreSkeletonApplication.Infrastructure.EntityFramework.csproj" />
    <ProjectReference Include="$(SpaRoot)\$(SpaClientName).esproj" Condition="'$(SpaClientName)' != ''">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
</Project>
