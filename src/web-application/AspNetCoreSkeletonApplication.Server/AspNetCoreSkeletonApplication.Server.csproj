<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AspNetCoreSkeletonApplication.Server</RootNamespace>
    <UserSecretsId>352c4267-d2dd-461e-8203-8604ccb52ac8</UserSecretsId>
  </PropertyGroup>
  <!--#if (frontend == "all") -->
  <!--
    SPA 클라이언트 선택: angular (기본) | sveltekit | nuxt
    예) dotnet run -p:SpaClient=sveltekit   또는   환경 변수 SpaClient=nuxt
    (스켈레톤 원본의 #if 주석은 dotnet new 템플릿용이다 — 원본에서는 그냥 주석이라 첫 줄 angular 가 기본값이 된다.)
  -->
  <!--#endif -->
  <PropertyGroup>
    <!--#if (frontend == "angular" || frontend == "all") -->
    <SpaClient Condition="'$(SpaClient)' == ''">angular</SpaClient>
    <!--#elif (frontend == "sveltekit") -->
    <SpaClient Condition="'$(SpaClient)' == ''">sveltekit</SpaClient>
    <!--#elif (frontend == "nuxt") -->
    <SpaClient Condition="'$(SpaClient)' == ''">nuxt</SpaClient>
    <!--#endif -->
    <SpaProxyLaunchCommand>npm start</SpaProxyLaunchCommand>
  </PropertyGroup>
  <Choose>
    <!--#if (frontend == "angular" || frontend == "all") -->
    <When Condition="'$(SpaClient)' == 'angular'">
      <PropertyGroup>
        <SpaClientName>asp-net-core-skeleton-application.client.angular</SpaClientName>
        <SpaProxyServerUrl>https://localhost:61194</SpaProxyServerUrl>
      </PropertyGroup>
    </When>
    <!--#endif -->
    <!--#if (frontend == "sveltekit" || frontend == "all") -->
    <When Condition="'$(SpaClient)' == 'sveltekit'">
      <PropertyGroup>
        <SpaClientName>asp-net-core-skeleton-application.client.sveltekit</SpaClientName>
        <SpaProxyServerUrl>https://localhost:61195</SpaProxyServerUrl>
      </PropertyGroup>
    </When>
    <!--#endif -->
    <!--#if (frontend == "nuxt" || frontend == "all") -->
    <When Condition="'$(SpaClient)' == 'nuxt'">
      <PropertyGroup>
        <SpaClientName>asp-net-core-skeleton-application.client.nuxt</SpaClientName>
        <SpaProxyServerUrl>https://localhost:61196</SpaProxyServerUrl>
      </PropertyGroup>
    </When>
    <!--#endif -->
  </Choose>
  <PropertyGroup>
    <SpaRoot>..\..\spa\$(SpaClientName)</SpaRoot>
  </PropertyGroup>
  <Target Name="ValidateSpaClient" BeforeTargets="Build" Condition="'$(SpaClientName)' == ''">
    <Error Text="알 수 없는 SpaClient '$(SpaClient)'. angular, sveltekit, nuxt 중 하나를 지정하세요." />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
    <!-- dotnet ef 의 시작 프로젝트 요건 (마이그레이션은 Common 에 있다) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Riok.Mapperly" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\common\AspNetCoreSkeletonApplication.Common\AspNetCoreSkeletonApplication.Common.csproj" />
    <ProjectReference Include="$(SpaRoot)\$(SpaClientName).esproj" Condition="'$(SpaClientName)' != ''">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
</Project>
