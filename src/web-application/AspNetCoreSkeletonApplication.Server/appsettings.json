{
  // 모든 프로파일 공통. 프로파일(ASPNETCORE_ENVIRONMENT)이 없으면 이 파일 + 환경변수만 쓴다.
  // 비밀값(ConnectionStrings:Default 등)은 여기에 적지 않는다 — README 「설정과 비밀값」 참고.
  "OpenApi": {
    "Enabled": false
  },
  // X-User-Id 헤더를 감사 주체로 믿을지 — 게이트웨이가 헤더를 덮어쓰는 배포에서만 true. README 「추적 ID 와 감사」
  "Audit": {
    "TrustUserHeader": false
  },
  // 외부 API 주소 — 비밀이 아니다. 환경마다 다르면 환경변수(Clients__ExampleApi__BaseAddress)로 덮어쓴다.
  "Clients": {
    "ExampleApi": {
      "BaseAddress": "https://api.example.com/"
    }
  },
  // 캐시 — 메모리(L1) + Redis(L2). Redis 연결 문자열은 비밀값 ConnectionStrings:Redis 다. README 「캐시」
  "Cache": {
    "Expiration": "00:10:00",
    "KeyPrefix": "asp-net-core-skeleton-application:"
  },
  // 메일 — SMTP. Host · Username · From 은 배포마다 환경변수(Mail__Smtp__Host …)로, Password 는 비밀값이다. README 「메일」
  "Mail": {
    "Smtp": {
      "Port": 587,
      "Security": "StartTls"
    }
  },
  // 넘으면 경고 로그를 남기는 임계값 — 느린 DB 명령 하나, 느린 HTTP 요청 하나
  "Diagnostics": {
    "SlowQueryThreshold": "00:00:00.500",
    "SlowRequestThreshold": "00:00:01"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    // 로그 줄마다 요청 scope(X-Trace-Id 등)를 함께 찍는다 — README 「추적 ID 와 감사」.
    // FormatterOptions 는 FormatterName 을 적어야 적용된다.
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*"
}
