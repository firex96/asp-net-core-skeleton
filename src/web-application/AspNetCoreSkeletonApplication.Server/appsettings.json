{
  // 모든 프로파일 공통. 프로파일(ASPNETCORE_ENVIRONMENT)이 없으면 이 파일 + 환경변수만 쓴다.
  // 비밀값(ConnectionStrings:Default 등)은 여기에 적지 않는다 — README 「설정과 비밀값」 참고.
  "OpenApi": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    // 로그 줄마다 요청 scope(TraceId 등)를 함께 찍는다 — README 「추적 ID 와 감사」
    "Console": {
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*"
}
