{
  // Local 프로파일 — docker compose(SQL Server · Redis · Mailpit)로 띄운 로컬 인프라에 붙는다. 값은 루트 docker-compose.yml 과 짝이다.
  // 실행: docker compose up -d && dotnet run --launch-profile https
  // 로컬 컨테이너 전용 계정이라 평문을 허용한다. 다른 값을 쓰려면 dotnet user-secrets 로 덮어쓴다.
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=skeleton;User ID=sa;Password=Skeleton!Passw0rd;Encrypt=True;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "OpenApi": {
    "Enabled": true
  },
  // 메일 링크가 가리키는 SPA 출처 — 기본 SPA(SpaClient)의 dev 서버. 다른 SPA 로 띄우면 App__PublicOrigin 으로 바꾼다.
  "App": {
    "PublicOrigin": "https://localhost:61194"
  },
  // docker compose 의 Mailpit(아무 계정이나 받는다). 받은 메일은 http://localhost:8025 에서 본다.
  "Mail": {
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Security": "None",
      "Username": "local",
      "Password": "local",
      "From": "AspNetCoreSkeletonApplication <no-reply@localhost>"
    }
  }
}
