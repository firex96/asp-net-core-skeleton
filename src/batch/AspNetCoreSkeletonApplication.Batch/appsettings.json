{
  // 모든 프로파일 공통. 프로파일(ASPNETCORE_ENVIRONMENT)이 없으면 이 파일 + 환경변수만 쓴다.
  // 비밀값(ConnectionStrings:Default 등)은 여기에 적지 않는다 — README 「설정과 비밀값」 참고.
  "OpenApi": {
    "Enabled": false
  },
  // 배치 Job 의 감사 주체는 언제나 시스템(0)이다 — 헤더를 믿지 않는다.
  "Audit": {
    "TrustUserHeader": false
  },
  // Job 마다 Batch:Jobs:{Job 클래스 이름} 섹션 하나 — 스케줄(Cron · Enabled)은 여기서만 정한다. README 「Batch」
  "Batch": {
    "Jobs": {
      // 샘플 — 30일 넘게 손대지 않은 Draft 상품을 매일 02:00 에 판매 종료한다(cron 은 Quartz 형식, 초부터)
      "DiscontinueStaleDraftJob": {
        "Enabled": true,
        "Cron": "0 0 2 * * ?",
        "StaleAfterDays": 30,
        "PageSize": 100,
        "AllowedParameters": []
      }
    },
    // 수동 실행 웹훅의 API 키. Key 는 비밀값이라 여기 적지 않는다 — Batch__Webhook__ApiKeys__0__Key 처럼 넣는다. README 「Batch」
    "Webhook": {
      "ApiKeys": []
    }
  },
  // 캐시 — 메모리(L1) + Redis(L2). Redis 연결 문자열은 비밀값 ConnectionStrings:Redis 다. README 「캐시」
  "Cache": {
    "Expiration": "00:10:00",
    "LocalExpiration": "00:00:30",
    "KeyPrefix": "asp-net-core-skeleton-application:"
  },
  // 넘으면 경고 로그를 남기는 임계값 — 느린 DB 명령 하나, 느린 HTTP 요청 하나
  "Diagnostics": {
    "SlowQueryThreshold": "00:00:00.500",
    "SlowRequestThreshold": "00:00:01"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    // 로그 줄마다 요청 scope(X-Trace-Id 등)를 함께 찍는다. FormatterOptions 는 FormatterName 을 적어야 적용된다.
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*"
}
