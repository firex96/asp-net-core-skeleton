<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    배치 앱 — Quartz.NET 으로 Job 을 스케줄하고, 수동 실행 웹훅과 운영 대시보드를 둔다. SPA 를 서빙하지 않는다.
    Common 을 다른 앱과 함께 쓰고, UserSecretsId 도 같다 — 로컬에서 같은 비밀(DB · Redis 연결 문자열)을 읽는다.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AspNetCoreSkeletonApplication.Batch</RootNamespace>
    <UserSecretsId>352c4267-d2dd-461e-8203-8604ccb52ac8</UserSecretsId>
    <!-- 대시보드(Blazor)가 쓰는 _framework/blazor.web.js 는 .NET 10 에서 정적 웹 자산이다 — 자체 .razor 가 없는 앱은 켜야 들어온다 -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Quartz" />
    <PackageReference Include="Quartz.Dashboard" />
    <PackageReference Include="Riok.Mapperly" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\common\AspNetCoreSkeletonApplication.Common\AspNetCoreSkeletonApplication.Common.csproj" />
  </ItemGroup>
</Project>
