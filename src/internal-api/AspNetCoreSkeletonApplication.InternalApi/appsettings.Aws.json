{
  // Aws 프로파일 — AWS Secrets Manager 의 JSON 비밀 하나에서 구성 키를 읽는다.
  //   SecretId : 비밀 이름 또는 ARN. 환경변수 Aws__SecretsManager__SecretId 로도 줄 수 있다
  //   리전·자격증명 : AWS SDK 기본 체인 (AWS_REGION, 인스턴스·태스크 역할 등)
  // 비밀 값 예: {"ConnectionStrings:Default": "Server=…;Database=…;User ID=…;Password=…"}
  "Aws": {
    "SecretsManager": {
      "SecretId": ""
    }
  }
}
