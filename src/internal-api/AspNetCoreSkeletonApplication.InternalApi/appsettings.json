{
  // 모든 프로파일 공통. 프로파일(ASPNETCORE_ENVIRONMENT)이 없으면 이 파일 + 환경변수만 쓴다.
  // 비밀값(ConnectionStrings:Default 등)은 여기에 적지 않는다 — README 「설정과 비밀값」 참고.
  "OpenApi": {
    "Enabled": false
  },
  // X-User-Id 헤더를 감사 주체로 믿을지. 내부 API 는 인증이 없어 헤더가 유일한 출처다 —
  // 게이트웨이가 인증 결과로 헤더를 덮어쓰고 밖에서 온 같은 헤더를 지우는 배포에서 true 로 켠다(Audit__TrustUserHeader).
  "Audit": {
    "TrustUserHeader": false
  },
  // 넘으면 경고 로그를 남기는 임계값 — 느린 DB 명령 하나, 느린 HTTP 요청 하나
  "Diagnostics": {
    "SlowQueryThreshold": "00:00:00.500",
    "SlowRequestThreshold": "00:00:01"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    // 로그 줄마다 요청 scope(X-Trace-Id 등)를 함께 찍는다. FormatterOptions 는 FormatterName 을 적어야 적용된다.
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*"
}
